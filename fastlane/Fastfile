default_platform(:ios)

APP_ID = "ru.malyshenskoe.crm"

platform :ios do
  desc "Сборка и отправка в App Store"
  lane :release do |options|
    api_key = app_store_connect_api_key(
      key_id: ENV["APPSTORE_KEY_ID"],
      issuer_id: ENV["APPSTORE_ISSUER_ID"],
      key_filepath: ENV["APPSTORE_KEY_PATH"],
      in_house: false
    )

    keychain_name = "build.keychain"
    keychain_password = "temp_ci_password"

    create_keychain(
      name: keychain_name,
      password: keychain_password,
      default_keychain: true,
      unlock: true,
      timeout: 3600,
      lock_when_sleeps: false
    )

    match(
      type: "appstore",
      app_identifier: APP_ID,
      api_key: api_key,
      git_url: "https://x-access-token:#{ENV["GH_TOKEN"]}@github.com/#{ENV["GITHUB_REPOSITORY"]}.git",
      git_branch: "certificates",
      storage_mode: "git",
      keychain_name: keychain_name,
      keychain_password: keychain_password,
      readonly: false,
      force_for_new_devices: false
    )

    profile_name = lane_context[SharedValues::MATCH_PROVISIONING_PROFILE_MAPPING][APP_ID]
    real_team = ENV["sigh_#{APP_ID}_appstore_team-id"] || ENV["APPLE_TEAM_ID"]

    UI.message("Профиль: #{profile_name}, команда: #{real_team}")

    update_code_signing_settings(
      path: "ios/App/App.xcodeproj",
      use_automatic_signing: false,
      team_id: real_team,
      bundle_identifier: APP_ID,
      profile_name: profile_name,
      code_sign_identity: "Apple Distribution",
      targets: ["App"]
    )

    unlock_keychain(path: keychain_name, password: keychain_password, set_default: true)

    build_app(
      workspace: "ios/App/App.xcworkspace",
      scheme: "App",
      configuration: "Release",
      output_directory: "/tmp/export",
      output_name: "App.ipa",
      export_method: "app-store",
      export_team_id: real_team,
      skip_profile_detection: true,
      xcargs: "DEVELOPMENT_TEAM='#{real_team}' CODE_SIGN_STYLE=Manual " \
              "PROVISIONING_PROFILE_SPECIFIER='#{profile_name}' " \
              "CODE_SIGN_IDENTITY='Apple Distribution'",
      export_options: {
        signingStyle: "manual",
        provisioningProfiles: { APP_ID => profile_name }
      }
    )

    if options[:upload].to_s == "true"
      upload_to_app_store(
        api_key: api_key,
        ipa: "/tmp/export/App.ipa",
        skip_screenshots: true,
        skip_metadata: true,
        precheck_include_in_app_purchases: false,
        submit_for_review: false
      )
    end
  end
end