default_platform(:ios)

APP_ID = "ru.malyshenskoe.crm"

platform :ios do
  desc "Сборка и отправка в App Store"
  lane :release do |options|
    api_key = app_store_connect_api_key(
      key_id: ENV["APPSTORE_KEY_ID"],
      issuer_id: ENV["APPSTORE_ISSUER_ID"],
      key_filepath: ENV["APPSTORE_KEY_PATH"],
      in_house: false
    )

    keychain_name = "build.keychain"
    keychain_password = "temp_ci_password"

    create_keychain(
      name: keychain_name,
      password: keychain_password,
      default_keychain: true,
      unlock: true,
      timeout: 3600,
      lock_when_sleeps: false
    )

    cert(
      api_key: api_key,
      development: false,
      keychain_path: File.expand_path("~/Library/Keychains/#{keychain_name}-db"),
      keychain_password: keychain_password,
      output_path: "/tmp/certs"
    )

    sigh(
      api_key: api_key,
      app_identifier: APP_ID,
      platform: "ios",
      output_path: "/tmp/profiles",
      readonly: false
    )

    profile_name = lane_context[SharedValues::SIGH_NAME]
    profile_uuid = lane_context[SharedValues::SIGH_UUID]
    profile_path = lane_context[SharedValues::SIGH_PROFILE_PATH]

    plist = `security cms -D -i "#{profile_path}"`
    real_team = plist[%r{<key>TeamIdentifier</key>\s*<array>\s*<string>([^<]+)</string>}m, 1]
    sign_identity = plist.include?("Apple Distribution") ? "Apple Distribution" : "iPhone Distribution"
    UI.message("Команда из профиля: #{real_team}, подпись: #{sign_identity}")

    install_provisioning_profile(path: profile_path)

    update_code_signing_settings(
      path: "ios/App/App.xcodeproj",
      use_automatic_signing: false,
      team_id: real_team,
      bundle_identifier: APP_ID,
      profile_name: profile_name,
      profile_uuid: profile_uuid,
      code_sign_identity: sign_identity,
      targets: ["App"]
    )

    unlock_keychain(path: keychain_name, password: keychain_password, set_default: true)

    build_app(
      workspace: "ios/App/App.xcworkspace",
      scheme: "App",
      configuration: "Release",
      output_directory: "/tmp/export",
      output_name: "App.ipa",
      export_method: "app-store",
      export_team_id: real_team,
      skip_profile_detection: true,
      xcargs: "DEVELOPMENT_TEAM='#{real_team}' CODE_SIGN_STYLE=Manual " \
              "PROVISIONING_PROFILE_SPECIFIER='#{profile_uuid}' " \
              "CODE_SIGN_IDENTITY='#{sign_identity}'",
      export_options: {
        signingStyle: "manual",
        provisioningProfiles: { APP_ID => profile_uuid }
      }
    )

    if options[:upload].to_s == "true"
      upload_to_app_store(
        api_key: api_key,
        ipa: "/tmp/export/App.ipa",
        skip_screenshots: true,
        skip_metadata: true,
        precheck_include_in_app_purchases: false,
        submit_for_review: false
      )
    end
  end
end