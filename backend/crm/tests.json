{
  "tests": [
    {
      "name": "Список броней",
      "method": "GET",
      "path": "/?table=bookings",
      "expectedStatus": 200
    },
    {
      "name": "Список объектов",
      "method": "GET",
      "path": "/?table=objects",
      "expectedStatus": 200
    },
    {
      "name": "Неизвестная таблица",
      "method": "GET",
      "path": "/?table=nope",
      "expectedStatus": 400
    },
    {
      "name": "Журнал действий читается",
      "method": "GET",
      "path": "/?table=activity_log&limit=5",
      "expectedStatus": 200
    },
    {
      "name": "Журнал нельзя изменить",
      "method": "POST",
      "path": "/?table=activity_log",
      "body": {
        "action": "hack"
      },
      "expectedStatus": 405
    },
    {
      "name": "Заявки на охоту",
      "method": "GET",
      "path": "/?table=hunt_requests",
      "expectedStatus": 200
    },
    {
      "name": "Заказы снабжения без входа",
      "method": "GET",
      "path": "/?table=supply_orders",
      "expectedStatus": 403
    }
  ]
}