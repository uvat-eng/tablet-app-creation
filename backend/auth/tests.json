{
  "tests": [
    {
      "name": "Неверный пароль",
      "method": "POST",
      "path": "/?action=login",
      "body": {
        "login": "admin",
        "password": "wrong"
      },
      "expectedStatus": 401
    },
    {
      "name": "Сессия без токена",
      "method": "GET",
      "path": "/?action=me",
      "expectedStatus": 401
    },
    {
      "name": "Сотрудники без прав",
      "method": "GET",
      "path": "/?action=staff",
      "expectedStatus": 403
    },
    {
      "name": "Регистрация без данных",
      "method": "POST",
      "path": "/?action=signup",
      "body": {
        "name": "",
        "login": ""
      },
      "expectedStatus": 400
    },
    {
      "name": "Смена пароля без входа",
      "method": "POST",
      "path": "/?action=change_password",
      "body": {
        "old_password": "x",
        "new_password": "yyyyy"
      },
      "expectedStatus": 401
    },
    {
      "name": "Доступы без прав владельца",
      "method": "GET",
      "path": "/?action=access",
      "expectedStatus": 403
    }
  ]
}