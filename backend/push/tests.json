      "expectedStatus": 401,
      "expectedBody": {"error": "string"},
      "bodyMatcher": "partial"
    },
    {
      "name": "Проверка метода OPTIONS",
      "method": "OPTIONS",
      "path": "/",
      "expectedStatus": 200
    }
  ]
